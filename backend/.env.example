# Application
APP_NAME=DP Analytics Platform
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production-use-long-random-string
API_PREFIX=/api/v1

# Storage
DATA_DIR=./data
PARQUET_DIR=./data/parquet
METADATA_DB_URL=sqlite:///./data/metadata.db
DUCKDB_PATH=./data/analytics.duckdb

# Upload limits
MAX_UPLOAD_SIZE_MB=5120
MAX_FILES_PER_BATCH=100
ALLOWED_EXTENSIONS=.xlsx,.xls,.csv,.zip

# Auth
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# CORS — include Vercel URL when deploying the public dashboard
CORS_ORIGINS=http://localhost:3000

# Cache
ANALYTICS_CACHE_TTL_SECONDS=300

# Logging
LOG_LEVEL=INFO

# LeadSquared live sync (secrets — never commit real values)
# Public Railway/Render host: keep LEADSQUARED_SYNC_ENABLED=false
LEADSQUARED_ACCESS_KEY=
LEADSQUARED_SECRET_KEY=
LEADSQUARED_API_HOST=https://api-in21.leadsquared.com/v2
LEADSQUARED_SYNC_ENABLED=false
LEADSQUARED_PAGE_SIZE=1000
LEADSQUARED_SYNC_WORKERS=3
SYNC_ADMIN_TOKEN=

# Google Sheets refund tracking (secrets — never commit service account JSON)
# Admissions team sheet: All Refund Cases
# https://docs.google.com/spreadsheets/d/14hrVKxRmitMsd2QNb3LhNaBbM59qwhH0oDJBu7hC66g/edit?gid=0
GOOGLE_REFUND_SPREADSHEET_ID=14hrVKxRmitMsd2QNb3LhNaBbM59qwhH0oDJBu7hC66g
GOOGLE_REFUND_SHEET_GID=0
GOOGLE_REFUND_SHEET_NAME=
# Public CSV (sheet shared as "Anyone with the link can view" — no service account needed)
GOOGLE_REFUND_PUBLIC_CSV_URL=https://docs.google.com/spreadsheets/d/14hrVKxRmitMsd2QNb3LhNaBbM59qwhH0oDJBu7hC66g/export?format=csv&gid=0
GOOGLE_SERVICE_ACCOUNT_JSON=
# Alternative: set GOOGLE_APPLICATION_CREDENTIALS to the JSON key path

# Google Sheets admissions (Fee Verification workbook)
# https://docs.google.com/spreadsheets/d/1TcFkmrpIE8QMIPT_P7pdG99M-sKH_qqL8gPUe9FYiKo
GOOGLE_ADMISSIONS_SPREADSHEET_ID=1TcFkmrpIE8QMIPT_P7pdG99M-sKH_qqL8gPUe9FYiKo
GOOGLE_ADMISSIONS_PAYMENTS_SHEET_NAME=All Payments - Admissions
GOOGLE_ADMISSIONS_PAYMENTS_SHEET_GID=
GOOGLE_ADMISSIONS_LMS_SHEET_NAME=LMS
GOOGLE_ADMISSIONS_LMS_SHEET_GID=
# Optional explicit public CSV URLs (gid required for auto-export URLs above)
GOOGLE_ADMISSIONS_PAYMENTS_PUBLIC_CSV_URL=
GOOGLE_ADMISSIONS_LMS_PUBLIC_CSV_URL=