# Vercel project settings (Root Directory = `frontend`)
# Set these in the Vercel dashboard → Settings → Environment Variables (Production).

# Static snapshots + leadership chrome
NEXT_PUBLIC_DATA_MODE=static
NEXT_PUBLIC_LEADERSHIP_MODE=true
NEXT_PUBLIC_ENABLE_UPLOAD=false
NEXT_PUBLIC_ENABLE_LSQ_SYNC=false
NEXT_PUBLIC_AUTO_LOGIN=false

# Email portal (production reports hub)
NEXT_PUBLIC_PORTAL_AUTH=true
PORTAL_AUTH_SECRET=<generate-a-new-secret-do-not-reuse-this-placeholder>
# 27 authorized users — use B64 (raw bcrypt $ breaks dotenv). Regenerate: npm run hash:emails
ALLOWED_EMAIL_HASHES_
# Admins for upload UI when a live API is wired. Static snapshot builds keep uploads off for everyone.
PORTAL_ADMIN_EMAILS=faiyaz.sabab@upgradsot.com
PORTAL_LOGIN_URL=https://your-portal.vercel.app/login
NEXT_PUBLIC_LOAN_OPS_URL=https://loan-ops.vercel.app

# Do NOT set NEXT_PUBLIC_API_URL for this mode (rewrites are disabled).

# Generate allowlist hashes (run locally, never commit plain emails):
#   cd frontend && node scripts/hash-allowlist-emails.mjs user@example.com

# Publish workflow (from your PC, after local upload/sync):
#   python backend/scripts/publish_snapshots.py
#   git add frontend/public/data/snapshots && git commit && git push
