# Local ops (talks to FastAPI on :8000)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_AUTO_LOGIN=true
NEXT_PUBLIC_DEFAULT_USER=ops
NEXT_PUBLIC_DEFAULT_PASSWORD=ops123
NEXT_PUBLIC_ENABLE_UPLOAD=true
NEXT_PUBLIC_ENABLE_LSQ_SYNC=false
# When backend SYNC_ADMIN_TOKEN is set (required in production):
# NEXT_PUBLIC_SYNC_ADMIN_TOKEN=<same value — ops UI only, never on Vercel leadership>

# Portal auth locally (email allowlist — copy hashes from .env.portal.example):
# NEXT_PUBLIC_PORTAL_AUTH=true
# PORTAL_AUTH_SECRET=<long-random-string>
# ALLOWED_EMAIL_HASHES_B64=<from npm run hash:emails>
# PORTAL_ADMIN_EMAILS=admin@example.com
# PORTAL_LOGIN_URL=http://localhost:3000/login
# NEXT_PUBLIC_LOAN_OPS_URL=https://loan-ops.vercel.app
#
# Production-like portal preview (static snapshots, no backend):
#   cp .env.portal.example .env.local && npm run dev

# Leadership / Vercel static mode (use .env.vercel.example instead):
# NEXT_PUBLIC_DATA_MODE=static
# NEXT_PUBLIC_LEADERSHIP_MODE=true
# NEXT_PUBLIC_ENABLE_UPLOAD=false
